# syntax=docker/dockerfile:1
# automations-service — self-contained build from a CLEAN GIT CHECKOUT.
#
# ─────────────────────────────────────────────────────────────────────────────
# WHY THIS FILE EXISTS ALONGSIDE ./Dockerfile
# ─────────────────────────────────────────────────────────────────────────────
# The sibling `Dockerfile` is a PACKAGING-ONLY recipe: it COPYs
#   backend/services/automations/dist
#   backend/erxes-api-shared/{dist,utils,core-types,core-modules}
# and never compiles anything. Those paths are gitignored, so
# `docker build -f Dockerfile` against a fresh `git clone` fails at COPY. It
# only works on a workstation that already ran `pnpm nx build automations-service`.
#
# Until now the compose worked around that by PULLING erxes/erxes-next-automations
# instead of building. That was defensible while this service carried zero fork
# divergence — but it no longer does, and a pulled image silently ships upstream's
# copy of code we have since fixed here. Concretely, checkValidTrigger in
# src/executions/calculateExecutions.ts now treats a trigger with no segment as
# "enrol" rather than passing an empty contentId to isInSegment, where
# Segments.getSegment('') throws and sendTRPCMessage swallows it into a `false`.
# Pulling would revert that fix without any deploy-time signal.
#
# This file is ADDITIVE rather than a rewrite of `Dockerfile` because that file
# is what project.json's `docker-build` target (dependsOn: ["build"]) invokes.
# Two recipes, two audiences. Deliberately mirrors
# backend/plugins/operation_api/Dockerfile.build — keep the family in sync.
#
# ─────────────────────────────────────────────────────────────────────────────
# BUILD CONTEXT IS THE REPO ROOT
# ─────────────────────────────────────────────────────────────────────────────
#   docker build -f backend/services/automations/Dockerfile.build .
# Nx, the pnpm workspace and tsconfig.base.json path aliases all resolve from
# the root, so the whole monorepo has to be in context.
#
# The runtime stage is deliberately the same LAYOUT the sibling Dockerfile
# produces (flattened node_modules + a hand-assembled node_modules/erxes-api-shared
# + dist at /app/dist), so the two images are drop-in interchangeable and
# `CMD node dist/src/main.js` is unchanged.

# ── Stage 1: compile the workspace ───────────────────────────────────────────
FROM node:22-alpine3.22 AS build
WORKDIR /app

# Nx's daemon adds no value in a single-shot container build and is a known
# source of flaky "project graph" races; disable it outright.
#
# NX_SOCKET_DIR is NOT redundant with NX_DAEMON=false. Nx asserts every IPC
# socket path is <= 95 chars and derives the default from a hash under $TMPDIR;
# pnpm's virtual store produces paths long enough to blow past it, and the
# plugin-worker path is exercised while building the project graph EVEN WITH
# THE DAEMON OFF. The thrown error surfaces as the cause-free
#   NX  Failed to process project graph.
# Pinning a short dir removes the whole failure class. See
# backend/plugins/frontline_api/Dockerfile.build for the full write-up.
ENV NX_DAEMON=false \
    NX_SOCKET_DIR=/tmp/nx-sock \
    NX_REJECT_UNKNOWN_LOCAL_CACHE=0 \
    CI=true

# pnpm via corepack rather than `npm install -g`: corepack reads the root
# package.json's `packageManager: "pnpm@9.12.3"` pin and provisions exactly that
# version, so the version can never drift from the lockfile's producer.
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME/bin:$PATH"
RUN corepack enable

# Full dev install: the build needs typescript, tsc-alias, preconstruct and the
# Nx toolchain, none of which survive a --prod install. This stage is discarded;
# only the compiled dist/ is carried forward.
#
# COPY THE WHOLE TREE, not a curated subset — nx.json's inference plugins load
# eslint.config.js / jest.config.ts / jest.preset.js FROM THE ROOT while crawling
# the graph. .dockerignore already strips node_modules/dist/.git/.nx.
COPY . .

# --frozen-lockfile: a deploy must fail loudly on a stale pnpm-lock.yaml rather
# than silently resolving different versions than were tested.
#
# The BuildKit cache mount persists pnpm's content-addressable store across
# builds, so unchanged packages are hard-linked from cache instead of being
# re-downloaded. `id=pnpm` is shared with every sibling Dockerfile.build and
# with the installer stage below so they all warm one store.
RUN --mount=type=cache,id=pnpm,target=/pnpm/store pnpm install --frozen-lockfile

# erxes-api-shared FIRST and as its own layer. This service only type-checks
# against it via tsconfig paths, so Nx's `dependsOn: ["^build"]` has been able to
# interleave the two; forcing the order removes that race from the deploy path.
RUN pnpm nx build erxes-api-shared

# tsc + tsc-alias -> backend/services/automations/dist/src/main.js
RUN pnpm nx build automations-service

# Fail loudly HERE rather than shipping an image whose CMD instantly exits.
# Only main.js is asserted — preconstruct legitimately leaves erxes-api-shared's
# output in either a dev-stub or a built-bundle state, so filename assertions
# there produce false failures.
RUN test -f backend/services/automations/dist/src/main.js \
    && echo "automations-service build OK"

# ── Stage 2: production dependency tree, flattened ───────────────────────────
# Identical technique to the sibling Dockerfile: synthesise a single-package
# manifest unioning the shared library's deps with the service's own, drop the
# `workspace:^` self-reference, and --shamefully-hoist so node's plain CommonJS
# resolver can walk a real flat node_modules with no pnpm symlink store.
FROM node:22-alpine3.22 AS installer
WORKDIR /app
# This stage DELIBERATELY keeps `npm install -g pnpm@9.12.3` instead of the
# corepack enable the build stage uses. Do not "fix" it to match.
#
# Corepack resolves its version from the nearest package.json's
# `packageManager` field, and this stage never copies the root one — it
# SYNTHESISES its own manifest below, which has no such field. With the field
# absent corepack does not fail; it falls back to a Known Good Release, i.e.
# effectively whatever the registry calls latest (pnpm 11.x at time of
# writing), which would resolve a lockfileVersion 9.0 lockfile with a different
# pnpm major. Pinning the version explicitly here is the whole point.
#
# PNPM_HOME is set because pnpm's default store lives at
# ~/.local/share/pnpm/store, which the target=/pnpm/store cache mount below
# would NOT cover; PNPM_HOME=/pnpm relocates it to /pnpm/store so the mount
# actually caches something.
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME/bin:$PATH"
RUN npm install -g pnpm@9.12.3

COPY pnpm-lock.yaml ./
COPY backend/services/automations/package.json backend/services/automations/
COPY backend/erxes-api-shared/package.json backend/erxes-api-shared/
RUN --mount=type=cache,id=pnpm,target=/pnpm/store node -e "\
const fs = require('fs'); \
const shared = require('./backend/erxes-api-shared/package.json'); \
const service = require('./backend/services/automations/package.json'); \
const dependencies = { \
  ...(shared.dependencies || {}), \
  ...(service.dependencies || {}), \
}; \
delete dependencies['erxes-api-shared']; \
fs.writeFileSync( \
  'package.json', \
  JSON.stringify( \
    { name: 'runtime-deps', version: '1.0.0', private: true, dependencies }, \
    null, \
    2, \
  ), \
); \
" \
    && pnpm install --prod --shamefully-hoist --no-frozen-lockfile \
    && find node_modules -type f \( \
         -name "*.d.ts" -o -name "*.map" -o -name "*.md" \
         -o -name "LICENSE*" -o -name "LICENCE*" \
         -o -name "CHANGELOG*" -o -name "README*" \
         -o -name "CONTRIBUTING*" -o -name "AUTHORS*" \
         -o -name ".npmignore" -o -name ".eslintrc*" -o -name "Makefile" \
       \) -delete \
    && find node_modules -mindepth 2 -maxdepth 3 -type d \( \
         -name "test" -o -name "tests" -o -name "__tests__" -o -name "spec" \
         -o -name "docs" -o -name "doc" -o -name "examples" -o -name "example" \
         -o -name ".github" -o -name "coverage" \
       \) -prune -exec rm -rf {} \; 2>/dev/null || true

# ── Stage 3: minimal runtime ─────────────────────────────────────────────────
FROM node:22-alpine3.22
WORKDIR /app

COPY --from=installer /app/node_modules ./node_modules

# The flat install above may have pulled a REGISTRY copy of erxes-api-shared
# (the name is published). Replace it wholesale with the workspace build so the
# service cannot silently link against a stale published version — which is the
# same class of problem as pulling the service image itself.
RUN rm -rf ./node_modules/erxes-api-shared
COPY --from=build /app/backend/erxes-api-shared/dist ./node_modules/erxes-api-shared/dist
COPY --from=build /app/backend/erxes-api-shared/utils ./node_modules/erxes-api-shared/utils
COPY --from=build /app/backend/erxes-api-shared/core-types ./node_modules/erxes-api-shared/core-types
COPY --from=build /app/backend/erxes-api-shared/core-modules ./node_modules/erxes-api-shared/core-modules
COPY --from=build /app/backend/erxes-api-shared/package.json ./node_modules/erxes-api-shared/

COPY --from=build /app/backend/services/automations/dist ./dist

ENV NODE_ENV=production
USER 1000

# ── HEALTHCHECK ──────────────────────────────────────────────────────────────
# Unlike the plugin APIs, nothing gates on this service being healthy — it joins
# no gateway and serves no subgraph, so an unhealthy automations-service cannot
# take core GraphQL down. It is still worth having: this service's whole job is
# draining BullMQ, and without a check a container that booted but never reached
# initMQWorkers looks identical to a working one.
#
# src/main.ts mounts `app.get('/health', ...)` before httpServer.listen(port),
# with port defaulting to 3302 — the same value the compose sets.
HEALTHCHECK --interval=10s --timeout=5s --start-period=180s --retries=12 \
  CMD ["node", "-e", "require('http').get('http://127.0.0.1:'+(process.env.PORT||3302)+'/health',r=>process.exit(r.statusCode===200?0:1)).on('error',()=>process.exit(1))"]

CMD ["node", "dist/src/main.js"]

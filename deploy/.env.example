# erxes v3 core stack — copy to .env and fill in REAL values.
# Every value below is a PLACEHOLDER. Nothing here is a real secret.

# ── Image version ───────────────────────────────────────────────────────────
# Pin a release tag; do NOT use `latest` (it moves several times a day — the
# erxes CI pushes on every merge to main).
# Verified to exist on Docker Hub for core-api, gateway and ui: 3.0.61
ERXES_VERSION=3.0.61

# ── Hostnames — TWO ARE REQUIRED ────────────────────────────────────────────
# Both resolve already via the existing *.sharksmarketing.com wildcard A record,
# so no new DNS records are needed.
#
# Why two and not one: the gateway is a catch-all reverse proxy that serves
# core-api's routes from its own root (/initial-setup, /get-frontend-plugins,
# /core-login, /oauth/*, /upload-chunked/*, ...) as well as /graphql and the
# ws:// subscription endpoint. Those paths collide with the UI's own client-side
# routes, and the UI derives every API path from one base (REACT_APP_API_URL),
# so a single host with PathPrefix rules cannot separate them reliably.
ERXES_UI_DOMAIN=erxes.sharksmarketing.com
ERXES_API_DOMAIN=erxes-api.sharksmarketing.com

# ── Secrets — REPLACE ALL THREE ─────────────────────────────────────────────
# Signs the auth cookie/JWT. Must be identical in core-api and gateway or every
# login is rejected. Generate: openssl rand -hex 32
JWT_TOKEN_SECRET=replace-me-openssl-rand-hex-32

MONGO_USER=erxes
# Generate: openssl rand -hex 24  (avoid @ : / ? # — it goes in a Mongo URI)
MONGO_PASSWORD=replace-me-mongo-password

# Generate: openssl rand -hex 24
REDIS_PASSWORD=replace-me-redis-password

# ── Optional / not set in the minimal stack ─────────────────────────────────
# ELASTICSEARCH_URL   Deliberately OMITTED. Search/segments degrade but the
#                     stack boots; elasticsearch/utils.ts defaults to
#                     http://localhost:9200 and is only touched lazily.
# ENABLED_PLUGINS     Left as "" in compose. Adding a plugin means adding a
#                     service named EXACTLY plugin-<name>-api (see compose
#                     header) AND listing <name> here on core-api + gateway.
# S3/AWS_*            Needed for file upload; unset = uploads fail.
# SENTRY_DSN / REACT_APP_SENTRY_DSN   Error tracking, optional.

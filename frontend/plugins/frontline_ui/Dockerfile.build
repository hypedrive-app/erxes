# frontline_ui — Module Federation remote, built from a CLEAN GIT CHECKOUT and
# served by nginx.
#
# ─────────────────────────────────────────────────────────────────────────────
# WHY A CONTAINER AT ALL — UI PLUGINS ARE NORMALLY CDN ARTIFACTS
# ─────────────────────────────────────────────────────────────────────────────
# Upstream never containerises a UI plugin. .github/workflows/ci-ui-frontline.yml
# runs `pnpm nx build frontline_ui` on the runner and then
#   aws s3 sync dist/frontend/plugins/frontline_ui s3://erxes-next/latest/frontline_ui/
# i.e. the artifact is pushed to erxes' R2 bucket behind plugins.erxes.io. That
# is why no UI plugin in this repo has a Dockerfile — this is the first.
#
# We cannot use that CDN. `origin` here is github.com/hypedrive-app/erxes, a
# FORK; our WhatsApp + Plivo frontline_ui is not on plugins.erxes.io, and the
# build that IS there is upstream's, whose GraphQL documents would not match
# our frontline_api schema. Publishing to our own R2 bucket would work but adds
# a second deploy channel (CI creds, bucket, custom domain) for one artifact.
# Since Dokploy already clones this repo and runs compose, serving the same
# `dist/` from a container in the same stack is strictly less moving parts.
#
# ─────────────────────────────────────────────────────────────────────────────
# THE URL LAYOUT IS LOAD-BEARING: /<version>/frontline_ui/remoteEntry.js
# ─────────────────────────────────────────────────────────────────────────────
# core-api answers GET /get-frontend-plugins with
#   `${PLUGIN_CDN_URL}/${version}/${plugin}_ui/remoteEntry.js`
# (backend/core-api/src/modules/organization/routes.ts). `version` comes from
# getPluginVersion() = `pluginInfo?.config?.releaseVersion || 'latest'`, so with
# no releaseVersion configured the browser requests
#   ${PLUGIN_CDN_URL}/latest/frontline_ui/remoteEntry.js
# The COPY below therefore lands the build at
#   /usr/share/nginx/html/latest/frontline_ui/
# which reproduces the exact `$FOLDER/frontline_ui/` shape the CI s3 sync
# creates. Keep the two in lockstep: this path IS the contract with routes.ts.
#
# `latest` is baked rather than parameterised on purpose. It is the value
# getPluginVersion() falls back to, and the erxes admin UI can set a per-plugin
# releaseVersion at runtime — but a container can only serve directories that
# exist at build time, so honouring an arbitrary runtime version would require
# fetching artifacts on boot. If you ever set a releaseVersion in the org
# config, add a matching directory here; otherwise leave it alone.
#
# ─────────────────────────────────────────────────────────────────────────────
# BUILD COST (measured, not estimated)
# ─────────────────────────────────────────────────────────────────────────────
# MEASURED via `/usr/bin/time -v pnpm nx build frontline_ui` on this tree:
# peak RSS 1.88 GB, ~48 s wall, 13 MB / 224 files of output. frontline_api's
# build is REPORTED to peak near 13.9 GB against ~9.9 GB free on the Hostinger
# box (not re-measured here). The order-of-magnitude gap is what matters: an
# OOMed compose build wedges Dokploy's queue (dokploy#4461) with no working
# Cancel, taking the whole stack down, and this build fits comfortably.
# The `pnpm install` in stage 1 is the dominant cost, not the compile.
#
# ─────────────────────────────────────────────────────────────────────────────
# BUILD CONTEXT IS THE REPO ROOT
# ─────────────────────────────────────────────────────────────────────────────
#   docker build -f frontend/plugins/frontline_ui/Dockerfile.build .
# Nx, the pnpm workspace and tsconfig.base.json aliases only resolve from the
# root. Named `.build` for symmetry with
# backend/plugins/frontline_api/Dockerfile.build, and to keep the door open for
# a future packaging-only `Dockerfile` matching the other services' convention.

# ── Stage 1: compile the remote ──────────────────────────────────────────────
FROM node:22-alpine3.22 AS build
WORKDIR /app

# Same Nx environment as backend/plugins/frontline_api/Dockerfile.build — see
# that file's header for why NX_SOCKET_DIR is NOT redundant with NX_DAEMON=false
# (nx asserts socket paths <= 95 chars and pnpm's virtual store blows past it on
# the plugin-worker path, surfacing as a cause-free "Failed to process project
# graph"). ci-ui-frontline.yml likewise exports NX_DAEMON=false.
ENV NX_DAEMON=false \
    NX_SOCKET_DIR=/tmp/nx-sock \
    NX_REJECT_UNKNOWN_LOCAL_CACHE=0 \
    CI=true

RUN npm install -g pnpm@9

# Whole tree, not a curated subset: nx.json's inference plugins load
# eslint.config.js / jest.config.ts / jest.preset.js from the ROOT while
# crawling the project graph. .dockerignore already strips node_modules, dist,
# .git and .nx. Same trap documented at length in frontline_api/Dockerfile.build.
COPY . .

RUN pnpm install --frozen-lockfile

# rspack + Module Federation -> dist/frontend/plugins/frontline_ui/
RUN pnpm nx build frontline_ui

# Fail HERE rather than shipping an nginx that 404s the one file that matters.
RUN test -f dist/frontend/plugins/frontline_ui/remoteEntry.js \
    && echo "frontline_ui build OK"

# ── Stage 2: static server ───────────────────────────────────────────────────
FROM nginx:alpine

# See the URL-layout note above: this directory shape is the contract with
# core-api's remoteEntry() helper, not a stylistic choice.
COPY --from=build /app/dist/frontend/plugins/frontline_ui \
                  /usr/share/nginx/html/latest/frontline_ui

COPY frontend/plugins/frontline_ui/nginx/default.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
